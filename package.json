{
  "name": "mx-player-max",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @mx-player-max/demo dev",
    "build": "pnpm -r --if-present build",
    "build:demo": "pnpm --filter @mx-player-max/demo build",
    "build:pages": "pnpm build && pnpm --filter @mx-player-max/demo build:pages && pnpm release:manifest && node scripts/release/prepare-pages.mjs",
    "typecheck": "pnpm -r --if-present build && pnpm -r --if-present typecheck",
    "test": "node scripts/quality/run-workspace-tests.mjs --check",
    "test:update-counts": "node scripts/quality/run-workspace-tests.mjs --update",
    "quality:acceptance-drift": "node scripts/quality/check-acceptance-drift.mjs",
    "test:browser": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "verify:packages": "node scripts/release/verify-packages.mjs",
    "release:manifest": "node scripts/release/generate-manifest.mjs",
    "test:release": "node --test scripts/release/tests/*.test.mjs",
    "test:quality": "node --test scripts/quality/tests/*.test.mjs",
    "quality:media": "node scripts/quality/verify-media-manifest.mjs",
    "quality:performance": "node scripts/quality/verify-performance-evidence.mjs",
    "quality:performance:collect": "node scripts/quality/collect-performance-baseline.mjs",
    "quality:audit": "node scripts/quality/audit-supply-chain.mjs",
    "quality:webgpu": "node scripts/quality/webgpu-kernel-probe.mjs",
    "quality:webgpu:numerics": "node scripts/quality/webgpu-kernel-numerics.mjs",
    "quality:webgpu:oracle": "node scripts/quality/webgpu-rt4ksr-oracle.mjs",
    "quality:webgpu:rife": "node scripts/quality/webgpu-rife-oracle.mjs",
    "quality:browsers": "node scripts/quality/verify-real-browser-evidence.mjs",
    "release:pack": "node scripts/release/pack-workspace.mjs",
    "release:smoke": "node scripts/release/consumer-smoke.mjs",
    "lint": "pnpm -r --if-present lint",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@webgpu/types": "0.1.64",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
